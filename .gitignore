# Python ignore rules for Bus Tracker.
# TODO: Add tool-specific local artifacts as the development workflow evolves.

# Python bytecode and interpreter artifacts
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test, coverage, and type-checker output
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# Environment and local configuration
.env
.env.*
!.env.example

# Local database files and uploaded content
database/*.db
database/.dev_jwt_secret
backend/uploads/*
!backend/uploads/.gitkeep

# Editor and operating system files
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
