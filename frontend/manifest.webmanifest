{
  "id": "/",
  "name": "BusTrack Fleet Command Center",
  "short_name": "BusTrack",
  "description": "Live college bus tracking, route management, and GPS route recording.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
