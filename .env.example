# Bus Tracker environment template. Never commit real values.
APP_ENV=production
LOG_LEVEL=INFO
# Trust proxy headers only from a known local proxy. Cloud Run deployments set
# this to * because Google controls the managed ingress path to the container.
FORWARDED_ALLOW_IPS=127.0.0.1
# RESET_DATABASE is intentionally omitted. It is rejected in production.
# In an autoscaled deployment set this to false on the public web service and
# true only on one continuously running worker service (min/max instances = 1).
BACKGROUND_JOBS_ENABLED=true
# Browser CSS/JS/image cache. HTML and authenticated APIs remain uncached.
STATIC_ASSET_CACHE_SECONDS=3600
# DATABASE_URL=postgresql://bus_tracker:change-me@localhost:5432/bus_tracker
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=5
# DATABASE_POOL_TIMEOUT=30
# DATABASE_POOL_RECYCLE=1800
# PostgreSQL retention: raw coordinates are short-lived operational data.
# Completed trips retain trip + stop arrival/departure timestamps only.
# TELEMETRY_RETENTION_ENABLED=true
# TELEMETRY_RETENTION_INTERVAL_SECONDS=300
# GPS_ACTIVE_LOCATION_MAX_PER_SOURCE=2
# Technician Provider Health keeps a rolling 24-hour raw coordinate feed by
# default. The supported range is 15 minutes through 7 days (10080 minutes).
# GPS_PROVIDER_HISTORY_RETENTION_MINUTES=1440
# Production keeps every mutation/error request but samples successful GETs.
# Use 0 to disable successful-GET request rows or 1 to record every GET.
REQUEST_AUDIT_SUCCESS_GET_SAMPLE_RATE=0.01
REQUEST_AUDIT_RETENTION_DAYS=30
# Student tracking prefers one Server-Sent Events connection and automatically
# falls back to five-second GET polling if this is disabled or unavailable.
STUDENT_LIVE_STREAM_ENABLED=true
# Driver source/status uses the same stream-first, polling-fallback policy.
DRIVER_SOURCE_STREAM_ENABLED=true
# Admin fleet tracking streams the existing live payload and falls back to
# ten-second GET polling if a proxy or browser cannot keep the stream open.
ADMIN_LIVE_STREAM_ENABLED=true
# JWT_SECRET_KEY=generate-at-least-32-random-characters-for-production
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-12-plus-character-password
JWT_ALGORITHM=HS256
# Secure dynamic bus passes: server-only Ed25519 PEM, separate from login JWT.
# Generate outside the repository; see docs/secure-bus-passes.md.
# BUS_PASS_SIGNING_KEY_PEM=provided-by-your-server-secret-manager
# One bounded school/work day. Sessions remain individually revocable by Admin.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Airotrack pull integration. Set the token in the deployment secret store only.
# Each bus's registration number is used as the Airotrack lookup keyword.
# AIROTRACK_API_TOKEN=replace-with-a-rotated-vendor-token
AIROTRACK_POLL_INTERVAL_SECONDS=20
# Kingstrack account pairs use company_id:user_id format. Keep real values in
# the deployment secret store and separate multiple accounts with commas.
# KINGSTRACK_ACCOUNTS=company_id:user_id,company_id:user_id
# Shared polling interval for every configured pull provider.
GPS_PROVIDER_POLL_INTERVAL_SECONDS=20
# Quarantine device timestamps farther than five minutes ahead of receipt time.
GPS_MAX_FUTURE_SKEW_SECONDS=300
# After two consecutive observations prove that an old/future device clock is
# advancing normally, order live tracking by trusted BusTrack receipt time.
GPS_CLOCK_FALLBACK_MIN_AGE_SECONDS=21600
GPS_CLOCK_RATE_TOLERANCE_SECONDS=60
# A replacement clock epoch may supersede an older raw timestamp only after the
# previous visible GPS snapshot has been stale for at least five minutes.
GPS_CLOCK_EPOCH_RECOVERY_STALE_SECONDS=300
# When a sleeping service wakes to delayed provider responses, pull through
# advancing queued heartbeats (bounded to protect the vendor API).
AIROTRACK_CATCHUP_MAX_REQUESTS=8
