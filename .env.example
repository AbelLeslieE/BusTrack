# Bus Tracker environment template. Never commit real values.
APP_ENV=production
# DATABASE_URL=postgresql+psycopg://bus_tracker:change-me@localhost:5432/bus_tracker
# JWT_SECRET_KEY=generate-at-least-32-random-characters-for-production
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=generate-a-unique-12-plus-character-password
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Airotrack pull integration. Set the token in the deployment secret store only.
# Each bus's registration number is used as the Airotrack lookup keyword.
# AIROTRACK_API_TOKEN=replace-with-a-rotated-vendor-token
AIROTRACK_POLL_INTERVAL_SECONDS=20
